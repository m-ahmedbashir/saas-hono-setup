# Copy to .env.local for local development. .env.local is gitignored (matches the
# root repo's .env.* convention) — never commit real values.

# Base URL of apps/api — the Better Auth client (src/lib/auth-client.ts) and all
# data fetching point here. Matches apps/api's default PORT (see ../../.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional. Set to "true" when deploying self-hosted (enables Next.js standalone output).
BUILD_STANDALONE=
