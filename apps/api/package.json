{
  "name": "@repo/api",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=../../.env.development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "seed:admin": "tsx --env-file=../../.env.development scripts/seed-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.0",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@sentry/hono": "^10.66.0",
    "@sentry/node": "^10.66.0",
    "hono": "^4.6.0",
    "stripe": "^22.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.1"
  }
}
