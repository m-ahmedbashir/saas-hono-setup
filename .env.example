# Copy this file to .env.development (and .env.test if needed) and fill in real values.
# .env.development / .env.test / .env.production are gitignored — never commit real credentials.

# Postgres connection string. A free Neon (https://neon.tech) instance works well for development.
# This is the owner/admin role — used only for running migrations (drizzle-kit).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A second, restricted role the app connects as for its own runtime queries — must NOT
# have BYPASSRLS, or Row-Level Security policies (e.g. on `billing`) silently do nothing.
# See AGENTS.md's Row-Level Security section for how to create this role.
APP_DATABASE_URL=postgresql://app_user:password@host/dbname?sslmode=require

# Optional. Postgres pool tuning (packages/db/src/index.ts) — defaults (20 / 30s / 10s)
# are fine for development; size DB_POOL_MAX for production against your actual Postgres
# connection limit and expected concurrency.
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Generate with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Base URL this API is served from.
BETTER_AUTH_URL=http://localhost:8787

PORT=8787

# Comma-separated list of origins allowed to call this API (used by both the Hono CORS
# middleware and Better Auth's trustedOrigins — see AGENTS.md).
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Sentry DSN for production error monitoring. Leave unset to disable Sentry
# entirely (no-op) — useful for local dev. See apps/api/src/instrument.ts.
SENTRY_DSN=

# Stripe (test-mode keys are fine for development — https://dashboard.stripe.com/test/apikeys).
# Only used inside apps/api/src/modules/billing/stripe-billing.service.ts.
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen --forward-to localhost:8787/billing/webhook`)
# or the webhook endpoint's settings in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the paid tiers in packages/core/src/billing/types.ts. Leave unset in
# dev if you haven't created them yet — checkout for that plan just fails clearly.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_INDIVIDUAL_PRO=
# Where Stripe Checkout redirects back to after a session completes/cancels.
BILLING_CHECKOUT_RETURN_URL=http://localhost:3000/billing
