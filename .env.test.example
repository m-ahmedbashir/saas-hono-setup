# Copy to .env.test to run apps/api's integration tests against the local Docker database
# (docker-compose.yml) instead of the database in .env.development. Only the database
# variables live here; everything else still comes from .env.development.
# Then: pnpm test:db (start + migrate + seed), and pnpm --filter @repo/api test.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/saas_test
# The restricted role tests run as — never the postgres superuser, which bypasses RLS and
# would make the Row-Level Security tests pass without proving anything.
APP_ROLE_PASSWORD=local-test-app-user
APP_DATABASE_URL=postgresql://app_user:local-test-app-user@localhost:55432/saas_test
